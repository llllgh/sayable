# Local integration verification only. Vite never bundles these values into web assets.

# === Text models ==========================================================
# Required overseas baseline: BytePlus ModelArk
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL_ID=deepseek-v4-flash-ga-260731

# Optional text provider: Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_ID=gemini-3.8-flash

# === Speech models ========================================================
# Required overseas baseline: BytePlus Speech
AUDIO_API_KEY=
AUDIO_BASE_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3/tts/unidirectional
ASR_API_KEY=
ASR_BASE_URL=wss://voice.ap-southeast-1.bytepluses.com/api/v3/sauc/bigmodel_async

# Optional pronunciation assessment: Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional ASR/TTS provider: Google Cloud Speech
# Streaming STT uses Service Account/OAuth; REST calls may use an API key.
GOOGLE_SPEECH_PROJECT_ID=
GOOGLE_SPEECH_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPEECH_LOCATION=global
GOOGLE_STT_MODEL=chirp_3
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Achernar

# === Android release signing =============================================
# Used by local signing scripts only.
# Create once with scripts/create-release-keystore.sh and keep it for all upgrades.
ANDROID_RELEASE_STORE_FILE=android/sayable-release.keystore
ANDROID_RELEASE_STORE_PASSWORD=
ANDROID_RELEASE_KEY_ALIAS=sayable
ANDROID_RELEASE_KEY_PASSWORD=
