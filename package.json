{
  "name": "sayable",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "An offline-first personal English expression trainer.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "android:debug": "bash scripts/android.sh debug",
    "android:install": "bash scripts/android.sh install",
    "android:release": "bash scripts/android.sh release"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "idb-keyval": "^6.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
